---

<BaseLayout title={title} description={description}>
  <header class="site-header">
    <div class="container nav">
      <a class="logo" href="/" aria-label="Redana - início">
        <span class="logo-mark" aria-hidden="true"><img src="/brand/icone-light.png" alt="" width="38" height="38" /></span>
        <span>Redana</span>
      </a>

      <nav class="nav-links" aria-label="Seções principais">
        <a href="#recursos">Recursos</a>
        <a href="#como-funciona">Como funciona</a>
        <a href="#precos">Preços</a>
        <a href="#escolas">Para escolas</a>
        <a href="#blog">Blog</a>
      </nav>

      <div class="nav-cta">
        <a class="btn btn-ghost" href="#entrar">Entrar</a>
        <a class="btn btn-primary" href="#comecar">Começar agora</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero container" id="comecar" data-animate>
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="hero-eyebrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"/>
              <path d="M19 14l.8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8L19 14z"/>
              <path d="M5 15l.6 1.7L7 17l-1.4.3L5 19l-.6-1.7L3 17l1.4-.3L5 15z"/>
            </svg>
            Correção inteligente de redações com IA
          </span>
          <h1>Sua melhor redação, com <span class="accent">inteligência.</span></h1>
          <p class="hero-sub">
            A Redana corrige, analisa e dá feedbacks detalhados para você evoluir em cada competência do ENEM.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#comecar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"/>
              </svg>
              Começar agora
            </a>
            <a class="btn btn-secondary" href="#como-funciona">
              <span class="play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              Ver como funciona
            </a>
          </div>

          <ul class="hero-features" aria-label="Diferenciais rápidos">
            <li class="hero-feature">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
              </span>
              <span><strong>Correção em</strong>segundos</span>
            </li>
            <li class="hero-feature">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
              </span>
              <span><strong>Feedbacks claros</strong>e objetivos</span>
            </li>
            <li class="hero-feature">
              <span class="icon bar-chart" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg>
              </span>
              <span><strong>Evolução garantida</strong>competência por competência</span>
            </li>
          </ul>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-mascot">
            <img src="/mascot.png" alt="" width="480" height="620" loading="eager" />
          </div>

          <div class="score-card" role="figure" aria-label="Exemplo de nota estimada 920, Excelente!">
            <div class="row1">
              <div class="value-block">
                <div class="label">Nota estimada</div>
                <div class="value">920</div>
              </div>
              <span class="pill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2l2.6 6.4L21 9l-5 4.6L17.4 21 12 17.6 6.6 21 8 13.6 3 9l6.4-.6L12 2z"/>
                </svg>
                Excelente!
              </span>
            </div>
            <p class="caption">Parabéns! Você está entre os melhores.</p>

            <div class="bars">
              <div class="bar-row">
                <div class="meta"><span class="meta-name">Competência I</span></div>
                <div class="score">180 <em>/ 200</em></div>
                <div class="bar-track"><div class="bar-fill" style="width:90%"></div></div>
              </div>
              <div class="bar-row">
                <div class="meta"><span class="meta-name">Competência II</span></div>
                <div class="score">200 <em>/ 200</em></div>
                <div class="bar-track"><div class="bar-fill" style="width:100%"></div></div>
              </div>
              <div class="bar-row">
                <div class="meta"><span class="meta-name">Competência III</span></div>
                <div class="score">180 <em>/ 200</em></div>
                <div class="bar-track"><div class="bar-fill" style="width:90%"></div></div>
              </div>
              <div class="bar-row">
                <div class="meta"><span class="meta-name">Competência IV</span></div>
                <div class="score">180 <em>/ 200</em></div>
                <div class="bar-track"><div class="bar-fill" style="width:90%"></div></div>
              </div>
              <div class="bar-row">
                <div class="meta"><span class="meta-name">Competência V</span></div>
                <div class="score">180 <em>/ 200</em></div>
                <div class="bar-track"><div class="bar-fill" style="width:90%"></div></div>
              </div>
            </div>

            <div class="footer">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 21h8"/>
                  <path d="M12 17v4"/>
                  <path d="M5 4h14v3a7 7 0 01-14 0V4z"/>
                  <path d="M19 5h2v2a4 4 0 01-4 4"/>
                  <path d="M5 5H3v2a4 4 0 004 4"/>
                </svg>
              </span>
              <div class="footer-text">
                <strong>Excelente trabalho!</strong>
                Continue assim e alcance sua melhor versão.
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-stats" aria-label="Prova social numérica">
        <div class="hero-stat">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="8" r="3.2"/>
              <path d="M3 20c.6-3.4 3.1-5.4 6-5.4s5.4 2 6 5.4"/>
              <circle cx="17" cy="9" r="2.6"/>
              <path d="M14 20c.5-2.6 1.7-4.2 3-4.8"/>
            </svg>
          </span>
          <div class="info"><strong>+50.000</strong><span>estudantes já evoluíram</span></div>
        </div>
        <div class="hero-stat">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="3" width="14" height="18" rx="2"/>
              <path d="M8 8h6M8 12h6M8 16h4"/>
              <path d="M18 7h2v12a2 2 0 01-2 2"/>
            </svg>
          </span>
          <div class="info"><strong>+200.000</strong><span>redações corrigidas</span></div>
        </div>
        <div class="hero-stat">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9L12 2.5z"/>
            </svg>
          </span>
          <div class="info"><strong>4.9/5</strong><span>avaliação dos usuários</span></div>
        </div>
        <div class="hero-stat">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="11" width="14" height="9" rx="2"/>
              <path d="M8 11V8a4 4 0 018 0v3"/>
              <circle cx="12" cy="15.5" r="1.2"/>
              <path d="M12 16.7v1.6"/>
            </svg>
          </span>
          <div class="info"><strong>Seus dados</strong><span>sempre protegidos</span></div>
        </div>
      </div>
    </section>

    <section class="section" aria-label="Prova social numérica">
      <div class="container proof-strip">
        <div class="proof-item">
          <strong>+1.200</strong>
          <span>redações corrigidas na plataforma</span>
        </div>
        <div class="proof-item">
          <strong>5 competências</strong>
          <span>com feedback individual e objetivo</span>
        </div>
        <div class="proof-item">
          <strong>R$ 0,23</strong>
          <span>por dia no plano anual (30% off)</span>
        </div>
        <div class="proof-item">
          <strong>5 grátis</strong>
          <span>sem cartão. Cancele quando quiser.</span>
        </div>
      </div>
    </section>

    <section class="section" id="beneficios" data-animate>
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Por que a Redana</span>
          <h2>Escrever mais não resolve. Saber o que corrigir, resolve.</h2>
          <p class="lead" style="margin-inline:auto">
            A maioria dos estudantes treina redação no escuro — escreve, entrega, recebe uma nota e não sabe o que fazer com ela. A Redana quebra esse ciclo: você vê exatamente onde perdeu pontos, por quê, e o que fazer diferente na próxima.
          </p>
        </div>

        <div class="grid-3 value-grid">
          {
            values.map((item) => (
              <article class="card">
                <div class="value-icon">{item.icon}</div>
                <h3>{item.title}</h3>
                <p class="muted">{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="como-funciona" style="padding-top:0" data-animate>
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Como funciona</span>
          <h2>Simples o suficiente para virar hábito.</h2>
          <p class="lead" style="margin-inline:auto">
            Menos fricção. Mais evolução. Três passos para transformar cada redação em aprendizado real.
          </p>
        </div>

        <div class="grid-3">
          {
            steps.map((step) => (
              <article class="card step-card">
                <div class="step-num">{step.num}</div>
                <h3>{step.title}</h3>
                <p class="muted">{step.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="depoimentos" style="background: rgba(255,255,255,0.45)" data-animate>
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Depoimentos</span>
          <h2>Quem treina com clareza sobe de nota com mais confiança.</h2>
          <p class="lead" style="margin-inline:auto">
            Histórias reais de quem parou de adivinhar e passou a treinar com direção.
          </p>
        </div>

        <TestimonialCarousel />
      </div>
    </section>

    <section class="section" id="precos" data-animate>
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Planos</span>
          <h2>Quanto custa parar de treinar no escuro?</h2>
          <p class="lead" style="margin-inline:auto">
            Menos que um café por dia. Escolha seu plano, comece com as 5 correções grátis e só pague se o método fizer sentido para você.
          </p>
        </div>

        <p class="pricing-toggle-note">
          O plano <strong>Anual</strong> custa <strong>R$ 0,23 por dia</strong>. O <strong>Trimestral</strong> dá 15% off. O <strong>Mensal</strong> é flexível, sem fidelidade. E o <strong>Free</strong> tem 5 correções sem cartão.
        </p>

        <div class="grid-2" style="grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem;">
          {
            plans.map((plan) => (
              <article class:list={['card', 'price-card', { featured: plan.featured }]}>
                {plan.badge && <div class="price-badge">{plan.badge}</div>}
                <div class="plan-name">{plan.name}</div>
                <div class="plan-price">
                  <strong>{plan.price}</strong>
                  {plan.period && <span>{plan.period}</span>}
        </div>

        <p class="pricing-guarantee" style="text-align:center;margin-top:1.25rem;color:var(--muted);font-size:0.9rem;">
          Cancele quando quiser, sem multa. Suas 5 correções grátis não expiram.
        </p>
                {plan.daily && <div class="plan-daily">{plan.daily}</div>}
                {plan.save && <div class="save-pill">{plan.save}</div>}
                <p class="plan-compare" set:html={plan.compare} />
                <ul class="plan-features">
                  {plan.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <a class:list={['btn', plan.featured ? 'btn-primary' : 'btn-secondary']} href="#comecar">
                  {plan.cta}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="faq" style="padding-top:0" data-animate>
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">FAQ</span>
          <h2>Perguntas que todo estudante faz antes de começar</h2>
        </div>

        <div class="faq" style="max-width:760px;margin-inline:auto">
          {
            faqs.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="final-cta">
          <div>
            <h2>Não deixe seus pontos no ENEM escaparem por falta de treino com direção.</h2>
            <p>
              Cada redação que você escreve sem saber o que melhorar é uma oportunidade perdida. Comece agora com as 5 correções grátis, veja sua primeira nota em minutos e decida se o plano faz sentido. Sem pressão, sem cartão.
            </p>
          </div>
          <div style="display:grid;gap:0.75rem">
            <a class="btn btn-primary" href="#precos">Quero minhas 5 correções grátis</a>
            <a class="btn btn-secondary" href="#precos">Ver planos e descontos</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="logo">
        <span class="logo-mark" aria-hidden="true"><img src="/brand/icone-light.png" alt="" width="38" height="38" /></span>
        <span>Redana</span>
      </div>
      <p>© {new Date().getFullYear()} Redana · Correção de redação ENEM com clareza e método.</p>
      <nav aria-label="Rodapé" style="display:flex;gap:1rem">
        <a href="#precos">Preços</a>
        <a href="#faq">FAQ</a>
        <a href="#comecar">Começar</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  @media (max-width: 1100px) {
    #precos .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 700px) {
    #precos .grid-2 {
      grid-template-columns: 1fr !important;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const animated = document.querySelectorAll('[data-animate]');
    if (!animated.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
    );

    animated.forEach((el) => observer.observe(el));
  });
</script>
