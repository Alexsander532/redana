  },
  {
    num: '3',
    title: 'Aplique e evolua',
    text: 'Use o plano de melhoria na próxima redação. Cada envio vira progresso mensurável.',
  },
];

// Testimonials agora vivem dentro do componente TestimonialCarousel

const plans = [
  {
    name: 'Anual',
    price: 'R$ 6,90',
    period: '/mês',
    daily: 'R$ 0,23/dia',
    compare: 'De <s>R$ 118,80</s> por <strong>R$ 82,80</strong> no ano. Menos que um café por dia.',
    save: '30% off — melhor custo',
    cta: 'Garantir desconto de 30%',
    featured: true,
    badge: 'Mais escolhido',
    features: [
      'Tudo do plano Mensal',
      '12 meses de evolução contínua',
      'Menor custo por correção',
      'Economia de 30% vs mensal',
    ],
  },
  {
    name: 'Trimestral',
    price: 'R$ 8,40',
    period: '/mês',
    daily: '',
    compare: 'De <s>R$ 29,70</s> por <strong>R$ 25,20</strong> no trimestre.',
    save: 'Economize 15%',
    cta: 'Quero com 15% off',
    featured: false,
    badge: null,
    features: [
      'Tudo do plano Mensal',
      '3 meses de treino contínuo',
      'Ideal para a reta final',
      'Economia de 15% vs mensal',
    ],
  },
  {
    name: 'Mensal',
    price: 'R$ 9,90',
    period: '/mês',
    daily: '',
    compare: 'Flexível: assine agora e cancele quando quiser, sem multa.',
    save: null,
    cta: 'Assinar mensal',
    featured: false,
    badge: null,
    features: [
      'Correções ilimitadas',
      'Feedback completo por competência',
      'Histórico de evolução',
      'Cancele a qualquer momento',
    ],
  },
  {
    name: 'Free',
    price: 'Grátis',
    period: '',
    daily: '',
    compare: 'Comece agora, sem cartão e sem prazo.',
    save: null,
    cta: 'Testar de graça',
    featured: false,
    badge: null,
    features: [
      '5 correções gratuitas',
      'Nota estimada por competência',
      'Feedback inicial de melhoria',
      'Sem cadastro de cartão',
    ],
  },
