---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = 'https://redana.com.br/',
  ogImage = 'https://redana.com.br/og-image.png',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://redana.com.br/#organization',
      name: 'Redana',
      url: 'https://redana.com.br/',
      logo: 'https://redana.com.br/favicon.png',
      description:
        'Plataforma de correção de redação do ENEM com feedback claro, critérios oficiais e evolução nota a nota.',
      areaServed: 'BR',
      availableLanguage: 'pt-BR',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://redana.com.br/#website',
      url: 'https://redana.com.br/',
      name: 'Redana',
      description,
      inLanguage: 'pt-BR',
      publisher: { '@id': 'https://redana.com.br/#organization' },
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://redana.com.br/?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://redana.com.br/#website' },
      about: { '@id': 'https://redana.com.br/#organization' },
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Redana',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: '0',
        highPrice: '9.90',
        priceCurrency: 'BRL',
        offerCount: 4,
      },
      description:
        'Correção de redação do ENEM com feedback por competência, nota estimada e plano de melhoria.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'A correção segue os critérios oficiais do ENEM?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sim. O feedback é organizado pelas 5 competências oficiais da redação do ENEM, com nota estimada e pontos de melhoria em cada uma.',
          },
        },
        {
          '@type': 'Question',
          name: 'Quantas redações posso corrigir no plano gratuito?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No plano Free você tem 5 correções gratuitas para testar a plataforma sem cartão de crédito.',
          },
        },
        {
          '@type': 'Question',
          name: 'Qual plano vale mais a pena?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'O plano Anual oferece o maior desconto e o menor custo por mês. O Trimestral é ideal se você quer compromisso médio com economia. O Mensal é flexível para começar agora.',
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="correção de redação ENEM, corrigir redação ENEM online, feedback redação ENEM, nota redação ENEM, competências ENEM, treinar redação ENEM"
    />
    <meta name="author" content="Redana" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/png" sizes="156x166" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://redana.com.br" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Redana" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />
    <meta name="language" content="Portuguese" />
    <meta name="revisit-after" content="7 days" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
